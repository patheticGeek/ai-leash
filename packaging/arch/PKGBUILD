pkgname=ai-leash
pkgver=0.1.0
pkgrel=1
pkgdesc='A leash for AI'
arch=('x86_64')
url='https://github.com/patheticGeek/ai-leash'
license=('MIT')
depends=(
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsoup3'
  'webkit2gtk-4.1'
)
makedepends=('cargo' 'git' 'npm')
source=("git+https://github.com/patheticGeek/ai-leash.git#branch=master")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/ai-leash"
  export CARGO_HOME="$srcdir/cargo"
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "$srcdir/ai-leash"
  export CARGO_HOME="$srcdir/cargo"
  npm ci --ignore-scripts
  npm run build
  cargo build --release --locked --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$srcdir/ai-leash"
  install -Dm755 src-tauri/target/release/ai-leash \
    "$pkgdir/usr/bin/ai-leash"
  install -Dm644 packaging/arch/ai-leash.desktop \
    "$pkgdir/usr/share/applications/ai-leash.desktop"
  install -Dm644 public/logo.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/ai-leash.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
