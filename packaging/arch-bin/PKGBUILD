pkgname=ai-leash-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='A leash for AI'
arch=('x86_64')
url='https://github.com/patheticGeek/ai-leash'
license=('MIT')
provides=('ai-leash')
conflicts=('ai-leash')
depends=(
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsoup3'
  'webkit2gtk-4.1'
)
# No URLs: this PKGBUILD ships inside ai-leash-bin.tar.gz alongside the
# files it installs (see build-tarball.sh), so makepkg needs no network
# access at all.
source=(
  'ai-leash'
  'ai-leash.desktop'
  'ai-leash-32.png'
  'ai-leash-128.png'
  'ai-leash-256.png'
  'LICENSE'
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
  install -Dm755 "$srcdir/ai-leash" "$pkgdir/usr/bin/ai-leash"
  install -Dm644 "$srcdir/ai-leash.desktop" \
    "$pkgdir/usr/share/applications/ai-leash.desktop"
  install -Dm644 "$srcdir/ai-leash-32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/ai-leash.png"
  install -Dm644 "$srcdir/ai-leash-128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/ai-leash.png"
  install -Dm644 "$srcdir/ai-leash-256.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256@2/apps/ai-leash.png"
  install -Dm644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
